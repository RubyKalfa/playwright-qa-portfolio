{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI and API testing portfolio using an isolated local issue tracker",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/server.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
